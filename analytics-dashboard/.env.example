HOST=127.0.0.1
PORT=3000
# Relative paths resolve from analytics-dashboard, not the shell's directory.
DATABASE_PATH=./data/analytics.sqlite
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Leave empty for direct connections. Set only to known proxy IPs/CIDRs.
# Never use a blanket trust-all setting on an Internet-facing deployment.
TRUSTED_PROXIES=
# Exact browser origin, without trailing slash. Use this same host in the browser.
ADMIN_ORIGIN=http://127.0.0.1:3000
# Production requires NODE_ENV=production and an explicit HTTPS ADMIN_ORIGIN.
# HTTPS automatically enables Secure cookies; there is no insecure production override.
NODE_ENV=development
ADMIN_SESSION_TTL_MINUTES=480
# Failed attempts per network AND per username in each 15-minute window.
LOGIN_FAILURE_LIMIT=5

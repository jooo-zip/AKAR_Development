{
  "name": "akar-museum-analytics",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone anonymous museum analytics backend for AKAR",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:init": "node --env-file-if-exists=.env src/db/init.js",
    "db:inspect": "node --env-file-if-exists=.env src/db/inspect.js",
    "admin:create": "node --env-file-if-exists=.env src/auth/create-admin.js",
    "test": "node --test"
  },
  "dependencies": {
    "express": "5.3.0",
    "express-rate-limit": "8.7.1"
  }
}

[resource]
script = ExtResource("1_content")
title = "Meet Urduja House"
body = "Urduja House stands within the provincial government complex in Lingayen, Pangasinan. Construction of the governor's official residence began in 1953. Today, it remains the official residence of the Governor of Pangasinan."
image = ExtResource("2_photo")
transcript = "Urduja House stands within the provincial government complex in Lingayen, Pangasinan. Construction of the governor's official residence began in 1953. A historical photograph from September 1982 provides a view of the residence during an earlier period. Today, Urduja House remains the official residence of the Governor of Pangasinan, connecting this historic landmark with continuing provincial governance."

hotspot_id = "UH-EXT-02"
title = "WHY IT WAS BUILT"
subtitle = "The Beginning of an Official Residence"
takeaway = "Urduja House was established as a dedicated official residence for Pangasinan's provincial governor."
introduction = ""
reflection = ""
historical_references = "Provincial Government of Pangasinan record, as identified in the researcher-approved Phase 5 material (4 October 2026). Exact bibliographic details unresolved."
media_credits = "Portrait: Painted Portraits of Governors Gallery, Pangasinan Provincial Capitol. Painter, image photographer and permission/license undocumented.\n\nHistorical photograph: I Love Pangasinan, “Urduja House in Lingayen Pangasinan”; September 1982. Photographer and permission/license unresolved.\n\n1953: date panel, not a historical photograph.\n\nNarration: researcher-supplied and approved despite duplicate-file detection. Individual recording credit/rights unresolved."
transcript = "The Provincial Government of Pangasinan records that the residence was constructed for Governor Juan de Guzman Rodriguez. Urduja House was established to serve as the official residence of the Governor of Pangasinan. Construction of the governor's official residence began in 1953."

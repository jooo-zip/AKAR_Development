[sub_resource type="Resource" id="Concept0"]
script = ExtResource("entry")
heading = "Public Interior"
body = "This conference room forms part of the publicly accessible interior of Urduja House."

[sub_resource type="Resource" id="Concept1"]
script = ExtResource("entry")
heading = "Official Function"
body = "Together with the reception spaces and Ceremonial Hall, it reflects the continuing use of Urduja House for selected government functions."

[sub_resource type="Resource" id="Concept2"]
script = ExtResource("entry")
heading = "Why It Matters"
body = "Its inclusion helps visitors understand that the building is both historically important and presently active."
show_takeaway = true

[resource]
script = ExtResource("content")
hotspot_id = "UH-INT-04"
title = "Conference Room"
prompt = "Discover its continuing function"
illustration = ExtResource("image")
illustration_alt_text = "Pixel-art illustration of the Conference Room inside Urduja House, showing a long central conference table surrounded by chairs, wood-paneled interior surfaces, curtained windows, ceiling lighting, and a display screen at the far end of the room."
narration_stream = ExtResource("audio")
narration_transcript = "This conference room forms part of the publicly accessible interior of Urduja House. Together with its reception and ceremonial spaces, it reflects the continuing official function of the residence."
learning_takeaway = "Urduja House remains a functioning government residence rather than only a historical display."
source_credit = "Historical / Educational Content
Validated AKAR Urduja House Conference Room hotspot content.

Visitor-Facing Illustration
Pixel-art illustrative representation created for the AKAR Capstone Project.

Visual Reference
Based on a Conference Room photograph published by the Province of Pangasinan in connection with:

\"PPC Interim Governing Board approves curricula of four academic programs\"

Reference Status
Used as a visual/layout reference."

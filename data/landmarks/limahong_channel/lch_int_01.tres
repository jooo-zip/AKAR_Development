[sub_resource type="Resource" id="Who"]
script = ExtResource("2")
heading = "LIMAHONG / LIN FENG"
body = "Limahong, also known as Lin Feng, was a Chinese pirate and military leader. After his failed attacks on Manila in late 1574, he sailed to Pangasinan and established a fortified settlement."

[sub_resource type="Resource" id="Site"]
script = ExtResource("2")
heading = "WHY THIS SITE?"
body = "During the 1575 campaign, Limahong and part of his force escaped from Pangasinan by water. The present Limahong Channel is traditionally associated with that escape route."


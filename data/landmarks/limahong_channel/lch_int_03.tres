[resource]
script = ExtResource("content")
hotspot_id = "LCH-INT-03"
title = "FROM ESCAPE ROUTE TO HERITAGE DESTINATION"
prompt = "EXPLORE THE CHANNEL'S MODERN LEGACY"
documentary_label = "JUNE 2019
LIMAHONG CHANNEL TOURISM CENTER
GROUNDBREAKING"
present_site_label = "PRESENT-SITE CONTEXT · AKAR research team"
contributor_name = "LEOPOLDO N. BATAOIL"
contributor_role = "MODERN HERITAGE DEVELOPMENT"
contributor_body = "Former representative Leopoldo N. Bataoil promoted the Limahong Channel Tourism Center, authored the House measure identifying the channel as a tourist spot, and co-led its 2019 groundbreaking."
preservation_nodes = PackedStringArray("HISTORICAL MEMORY", "HERITAGE EDUCATION", "TOURISM INITIATIVES")
plan_heading = "ORIGINAL DEVELOPMENT PLAN"
qualification = "Development has proceeded in phases. Facilities listed in the original development plan should not automatically be interpreted as completed facilities."
groundbreaking = SubResource("Groundbreaking")
contributor_image = SubResource("Bataoil")
present_site = SubResource("PresentSite")
concepts = Array[ExtResource("base_entry")]([SubResource("Milestone"), SubResource("Preservation"), SubResource("Development")])
facilities = Array[ExtResource("facility")]([SubResource("Park"), SubResource("Pavilion"), SubResource("Artifacts"), SubResource("Cruise"), SubResource("Garden"), SubResource("Forest"), SubResource("EcoPark"), SubResource("Activity"), SubResource("Roads")])
narration_transcript = "The Limahong Channel Tourism Center reached an important milestone with its groundbreaking in June 2019. The site's historical association supports heritage education and tourism initiatives. Development has continued in phases, so facilities included in the original plan should be distinguished from those confirmed as completed."
source_credit = "2019 MILESTONE
Researcher-supplied Philippine News Agency metadata: article author Hilda Austria; photograph by Liwayway Yparraguirre; June 2019 groundbreaking. Exact article title, URL and publication date remain pending. No claim that the whole center was completed in 2019 is made.

MODERN CONTRIBUTOR
Researcher-supplied role statement for Leopoldo N. Bataoil. Municipality of Lingayen official website image and identifying page context supplied by researcher. Exact page URL and House-measure citation remain pending.

HERITAGE SIGNIFICANCE
Source-backed project content prepared for validation. The site's historical association supports heritage education and tourism initiatives. A signed validator approval is not claimed.

DEVELOPMENT PLAN
The nine categories are from the researcher-supplied original development plan. Full plan document citation and independently supported current facility statuses remain pending. All categories are labelled ORIGINAL PLAN. The present-site photograph provides present-day context only; it does not verify completion of the planned facilities.

MEDIA CREDITS
Credits and known metadata are listed below. PNA and Municipality of Lingayen reuse permissions remain pending. The present-site image is research-team captured and authorized for AKAR use; its individual photographer remains pending. Its embedded EXIF capture timestamp is recorded in the media metadata, with no timezone supplied."

[resource]
script = ExtResource("content")
groundbreaking = SubResource("Groundbreaking")
contributor_image = SubResource("Bataoil")
present_site = SubResource("PresentSite")
documentary_label = "JUNE 2019
LIMAHONG CHANNEL TOURISM CENTER
GROUNDBREAKING"
present_site_label = "PRESENT-SITE CONTEXT · AKAR research team"
contributor_name = "LEOPOLDO N. BATAOIL"
contributor_role = "MODERN HERITAGE DEVELOPMENT"
contributor_body = "Former representative Leopoldo N. Bataoil promoted the Limahong Channel Tourism Center, authored the House measure identifying the channel as a tourist spot, and co-led its 2019 groundbreaking."
preservation_nodes = PackedStringArray("HISTORICAL MEMORY", "HERITAGE EDUCATION", "TOURISM INITIATIVES")
plan_heading = "ORIGINAL DEVELOPMENT PLAN"
qualification = "Development has proceeded in phases. Facilities listed in the original development plan should not automatically be interpreted as completed facilities."
facilities = Array[ExtResource("facility")]([SubResource("Park"), SubResource("Pavilion"), SubResource("Artifacts"), SubResource("Cruise"), SubResource("Garden"), SubResource("Forest"), SubResource("EcoPark"), SubResource("Activity"), SubResource("Roads")])
hotspot_id = "LCH-INT-03"
title = "FROM ESCAPE ROUTE TO HERITAGE DESTINATION"
prompt = "EXPLORE THE CHANNEL'S MODERN LEGACY"
narration_stream = ExtResource("header_narration")
narration_transcript = "The Limahong Channel Tourism Center reached an important milestone with its groundbreaking in June 2019. The site's historical association supports heritage education and tourism initiatives. Development has continued in phases, so facilities included in the original plan should be distinguished from those confirmed as completed."
source_credit = "HISTORICAL REFERENCES

Austria, H. (2018).
Limahong Channel Tourism Center to Be Built This Year.
Philippine News Agency.

Austria, H. (2019).
Limahong Channel Tourism Center in Pangasinan Groundbreaks.
Philippine News Agency.

Municipality of Lingayen. (2020).
Limahong Channel Tourism Center Soon to Be Operational.

Municipality of Lingayen. (2025).
Bidding Documents for the Construction of a Multi-Purpose Building in the Limahong Tourism Center, Barangay Pangapisan North, Lingayen, Pangasinan.

Pasiliao, J. J. (2020).
Limahong Channel Hub to Boost Tourism, Jobs in Pangasinan Town.
Philippine News Agency.


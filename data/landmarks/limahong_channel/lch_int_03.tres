[sub_resource type="Resource" id="Milestone"]
script = ExtResource("stage")
stage_id = "milestone_2019"
short_label = "01 — 2019 MILESTONE"
compact_label = "2019"
takeaway = "It marked an important modern milestone in the site's heritage and tourism development."
heading = "2019 — A NEW MILESTONE"
body = "The groundbreaking of the Limahong Channel Tourism Center was held in June 2019 in Barangay Pangapisan Norte, Lingayen."

[sub_resource type="Resource" id="Preservation"]
script = ExtResource("stage")
stage_id = "preservation"
short_label = "02 — PRESERVING THE STORY"
compact_label = "PRESERVATION"
takeaway = "Modern heritage efforts give visitors another way to encounter and learn about the history remembered at the site."
heading = "PRESERVING THE STORY"
body = "The Limahong Channel preserves local memory of the 1575 Pangasinan campaign and Limahong's escape.

Its historical association also supports heritage education and tourism initiatives."

[sub_resource type="Resource" id="Development"]
script = ExtResource("stage")
stage_id = "development"
short_label = "03 — DEVELOPMENT IN PHASES"
compact_label = "DEVELOPMENT"
heading = "DEVELOPMENT IN PHASES"
body = "The Limahong Channel Tourism Center has been developed as a phased tourism project at the site."


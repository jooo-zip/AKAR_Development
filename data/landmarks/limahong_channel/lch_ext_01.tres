[gd_resource type="Resource" script_class="ConferenceRoomContent" format=3]

[ext_resource type="Script" path="res://scripts/components/conference_room_content.gd" id="1"]
[ext_resource type="Script" path="res://scripts/components/conference_room_concept_entry.gd" id="2"]

[sub_resource type="Resource" id="Where"]
script = ExtResource("2")
heading = "WHERE IS IT?"
body = "The Limahong Channel is a historical waterway located in Barangay Pangapisan Norte, Lingayen, Pangasinan."

[sub_resource type="Resource" id="History"]
script = ExtResource("2")
heading = "WHY IS IT HISTORIC?"
body = "The present-day Limahong Channel is traditionally associated with the route used by Limahong and part of his force to escape during the 1575 Pangasinan campaign."

[sub_resource type="Resource" id="Today"]
script = ExtResource("2")
heading = "THE SITE TODAY"
body = "Today, the Limahong Channel remains an important historical landmark associated with the memory of the 1575 campaign and forms part of local heritage and tourism initiatives in Lingayen."
show_takeaway = true

[resource]
script = ExtResource("1")
hotspot_id = "LCH-EXT-01"
title = "LIMAHONG CHANNEL"
prompt = "Meet the Limahong Channel"
learning_takeaway = "REMEMBER\nThe channel seen today is traditionally connected with Limahong's escape during the 1575 Pangasinan campaign."
source_credit = "Historical content\nResearcher-supplied LCH-EXT-01 text. Bibliographic citations pending researcher submission.\n\nMedia / photo credits\nLocator image and present-day photographs supplied in the project. Original source, photographer, and usage permissions pending researcher confirmation.\n\nNarration\nRecording pending content verification; playback is currently unavailable."
concepts = Array[ExtResource("2")]([SubResource("Where"), SubResource("History"), SubResource("Today")])

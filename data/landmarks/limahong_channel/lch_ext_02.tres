[sub_resource type="Resource" id="Manila"]
script = ExtResource("2")
heading = "FAILED ATTACKS ON MANILA"
body = "After his failed attacks on Manila in late 1574, Limahong left the area with his forces and sailed north."

[sub_resource type="Resource" id="Northward"]
script = ExtResource("2")
heading = "SAIL TO PANGASINAN"
body = "Limahong sailed to Pangasinan, bringing the conflict north from Manila."

[sub_resource type="Resource" id="Pangasinan"]
script = ExtResource("2")
heading = "FORTIFIED SETTLEMENT"
body = "In Pangasinan, Limahong established a fortified settlement.

This settlement became the setting of the 1575 campaign."
show_takeaway = true


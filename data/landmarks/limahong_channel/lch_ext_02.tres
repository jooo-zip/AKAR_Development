fortified_settlement = ExtResource("6")
schematic_points = null
hotspot_id = "LCH-EXT-02"
title = "FROM MANILA TO PANGASINAN"
illustration = ExtResource("3")
illustration_alt_text = "Researcher-supplied regional illustration with broad Manila and Pangasinan overlays."
narration_stream = ExtResource("header_narration")
narration_transcript = "After his failed attacks on Manila in late 1574, Limahong sailed north to Pangasinan and established a fortified settlement. This movement brought the conflict from Manila to Pangasinan and set the stage for the campaign that followed in 1575."
learning_takeaway = "REMEMBER
Limahong's retreat from Manila brought him to Pangasinan, where he established the fortified settlement that became the setting of the 1575 campaign."
source_credit = "HISTORICAL REFERENCES

Sande, F. de. (1903).
Relation of the Filipinas Islands.
In E. H. Blair & J. A. Robertson (Eds. & Trans.),
The Philippine Islands, 1493–1803, Vol. 4, pp. 21–97.
Original work dated 1576.

Shutz, J. T. (2019).
Limahong's Pirates, Ming Mariners, and Early Sino-Spanish Relations: The Pangasinan Campaign of 1575 and Global History from Below.
Philippine Studies: Historical and Ethnographic Viewpoints, 67(3–4), 315–342.

MEDIA CREDITS

All maps, route graphics, location markers, vessel graphics, fortified-settlement graphics, interface graphics, icons, and other visual resources used by LCH-EXT-02:
AKAR Project / AKAR Research Team.
Original project resources."

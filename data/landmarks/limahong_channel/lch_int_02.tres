[sub_resource type="Resource" id="Lavezaris"]
script = ExtResource("person")
person_id = "lavezaris"
role_label = "EXPEDITION PREPARATION"
connection_body = "His role was connected to organizing and preparing the expedition rather than leading it in the field."
portrait = ExtResource("lavezaris")
portrait_source = "Kahimyang.
\"Slavery Among the Natives according Guido de Lavezaris.\""
narration_transcript = "Governor-General Guido de Lavezaris appointed Juan de Salcedo as master-of-camp and oversaw preparations for the expedition against Limahong."
wide_anchor = Vector2(0.5, 0.22)
medium_anchor = Vector2(0.5, 0.26)
compact_anchor = Vector2(0.17, 0.31)
heading = "GUIDO DE LAVEZARIS"
body = "Governor-General Guido de Lavezaris appointed Juan de Salcedo as master-of-camp and oversaw preparations for the expedition against Limahong."
metadata/source_url = "https://kahimyang.com/kauswagan/articles/1705/slavery-among-the-natives-according-guido-de-lavezaris"

[sub_resource type="Resource" id="Salcedo"]
script = ExtResource("person")
person_id = "salcedo"
role_label = "EXPEDITION LEADER"
connection_body = "He led the expedition in the field during the 1575 Pangasinan campaign."
portrait = ExtResource("salcedo")
portrait_source = "Jardin Solei / The Crafty Historian.
\"The Love Story of Kandarapa and Juan de Salcedo: An Ill-Fated Romance.\"
June 7, 2020."
narration_transcript = "Juan de Salcedo led the Spanish and allied Luzonese expedition that blockaded Limahong's settlement in Pangasinan in 1575."
wide_anchor = Vector2(0.19, 0.78)
medium_anchor = Vector2(0.15, 0.73)
compact_anchor = Vector2(0.5, 0.31)
heading = "JUAN DE SALCEDO"
body = "Juan de Salcedo led the Spanish and allied Luzonese expedition that blockaded Limahong's settlement in 1575."
metadata/source_url = "https://jardinsolei.wordpress.com/2020/06/07/the-love-story-of-kandarapa-and-juan-de-salcedo-an-ill-fated-romance/comment-page-1/"

[sub_resource type="Resource" id="Limahong"]
script = ExtResource("person")
person_id = "limahong"
role_label = "SETTLEMENT & ESCAPE"
connection_body = "His settlement and escape in Pangasinan form the central historical narrative associated with the Limahong Channel."
portrait = ExtResource("limahong")
portrait_source = "Lingayen in Time, p. 5.
Scanned book copy used by the AKAR Research Team."
narration_transcript = "Limahong, also known as Lin Feng, established a fortified settlement in Pangasinan, and his 1575 escape became the central story associated with the Limahong Channel."
wide_anchor = Vector2(0.81, 0.78)
medium_anchor = Vector2(0.85, 0.73)
compact_anchor = Vector2(0.83, 0.31)
heading = "LIMAHONG / LIN FENG"
body = "Limahong, also known as Lin Feng, was a Chinese pirate leader. After his failed attacks on Manila in late 1574, he sailed to Pangasinan and established a fortified settlement."

[resource]
script = ExtResource("content")
panel_prompt = "MEET THE PEOPLE"
event_title = "1575 PANGASINAN CAMPAIGN"
event_subtitle = "Different historical roles were connected to the same campaign."
connection_heading = "CONNECTION TO THE 1575 CAMPAIGN"
comparison_hint = "Select each person to compare their role in the campaign."
hotspot_id = "LCH-INT-02"
title = "PEOPLE BEHIND THE 1575 CAMPAIGN"
prompt = "MEET THE PEOPLE CONNECTED WITH THE CAMPAIGN"
narration_stream = ExtResource("header_narration")
source_credit = "HISTORICAL REFERENCES

Sande, F. de. (1903).
Relation of the Filipinas Islands.
In E. H. Blair & J. A. Robertson (Eds. & Trans.),
The Philippine Islands, 1493–1803, Vol. 4, pp. 21–97.
Original work dated 1576.

Shutz, J. T. (2019).
Limahong's Pirates, Ming Mariners, and Early Sino-Spanish Relations: The Pangasinan Campaign of 1575 and Global History from Below.
Philippine Studies: Historical and Ethnographic Viewpoints, 67(3–4), 315–342.

The present Limahong Channel is traditionally associated with the escape narrative. This presentation does not establish the exact sixteenth-century escape channel through archaeological evidence.

MEDIA CREDITS

OTHER INTERFACE MEDIA
AKAR-created personality-card framing, interface graphics, icons, decorative elements, and diagrams:
AKAR Project / AKAR Research Team.
Original project resources."
concepts = Array[ExtResource("base_entry")]([SubResource("Lavezaris"), SubResource("Salcedo"), SubResource("Limahong")])
metadata/historical_source_urls = PackedStringArray("https://www.gutenberg.org/cache/epub/12635/pg12635-images.html", "https://doi.org/10.13185/2244-1638.1019")

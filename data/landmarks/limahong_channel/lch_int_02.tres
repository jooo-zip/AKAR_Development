[sub_resource type="Resource" id="Lavezaris"]
script = ExtResource("person")
person_id = "lavezaris"
heading = "GUIDO DE LAVEZARIS"
role_label = "EXPEDITION PREPARATION"
body = "Governor-General Guido de Lavezaris appointed Juan de Salcedo as master-of-camp and oversaw preparations for the expedition against Limahong."
connection_body = "His role was connected to organizing and preparing the expedition rather than leading it in the field."
portrait = ExtResource("lavezaris")
narration_transcript = "Governor-General Guido de Lavezaris appointed Juan de Salcedo as master-of-camp and oversaw preparations for the expedition against Limahong."
wide_anchor = Vector2(0.50, 0.22)
medium_anchor = Vector2(0.50, 0.26)
compact_anchor = Vector2(0.17, 0.31)

[sub_resource type="Resource" id="Salcedo"]
script = ExtResource("person")
person_id = "salcedo"
heading = "JUAN DE SALCEDO"
role_label = "EXPEDITION LEADER"
body = "Juan de Salcedo led the Spanish and allied Luzonese expedition that blockaded Limahong's settlement in 1575."
connection_body = "He led the expedition in the field during the 1575 Pangasinan campaign."
portrait = ExtResource("salcedo")
narration_transcript = "Juan de Salcedo led the Spanish and allied Luzonese expedition that blockaded Limahong's settlement in Pangasinan in 1575."
wide_anchor = Vector2(0.19, 0.78)
medium_anchor = Vector2(0.15, 0.73)
compact_anchor = Vector2(0.50, 0.31)

[sub_resource type="Resource" id="Limahong"]
script = ExtResource("person")
person_id = "limahong"
heading = "LIMAHONG / LIN FENG"
role_label = "SETTLEMENT & ESCAPE"
body = "Limahong, also known as Lin Feng, was a Chinese pirate leader. After his failed attacks on Manila in late 1574, he sailed to Pangasinan and established a fortified settlement."
connection_body = "His settlement and escape in Pangasinan form the central historical narrative associated with the Limahong Channel."
portrait = ExtResource("limahong")
narration_transcript = "Limahong, also known as Lin Feng, established a fortified settlement in Pangasinan, and his 1575 escape became the central story associated with the Limahong Channel."
wide_anchor = Vector2(0.81, 0.78)
medium_anchor = Vector2(0.85, 0.73)
compact_anchor = Vector2(0.83, 0.31)


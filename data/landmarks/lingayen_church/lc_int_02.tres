milestone_id = &"wartime_1945"
year_short = "1945"
date_display = "1945"
era_id = &"war_and_change"
era_display = "War & Institutional Change"
title = "Wartime Destruction"
context_label = "PREWAR CHURCH"
change_label = "1945 WARTIME DAMAGE"
explanation = "During the liberation of Lingayen on January 9, 1945, the bishop's residence was greatly damaged, the church was partially destroyed, and old church bells fell."
media_mode = &"DOCUMENTARY_PHOTO"
media = ExtResource("6")
media_caption = "Lingayen Church showing wartime/postwar damage."
media_credit = "SOURCE: Lingayen: Memories of Times Past (2021), p. 20."

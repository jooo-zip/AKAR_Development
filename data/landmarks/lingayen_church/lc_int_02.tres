[sub_resource type="Resource" id="Early"]
script = ExtResource("2")
milestone_id = &"early_mission"
year_short = "1500s"
date_display = "16th Century"
era_id = &"missionary_foundations"
era_display = "Missionary Foundations"
title = "Early Missionary Activity"
context_label = "EARLY CATHOLIC MISSION"
change_label = "AUGUSTINIAN MISSIONARIES"
result_label = "LATER DOMINICAN ADMINISTRATION"
explanation = "Catholic missionary activity began in Lingayen during the 16th century through Augustinian missionaries. The mission was later administered by the Dominicans."
source_basis = "Archdiocese of Lingayen-Dagupan; Epiphany parish history"
show_historical_note = true
historical_note_title = "Historical Note"
historical_note_body = "1710 is traditionally associated with the historic church structure, but it should not be treated as a confirmed parish founding date."

[sub_resource type="Resource" id="Transition"]
script = ExtResource("2")
milestone_id = &"transition_1898"
year_short = "1898"
date_display = "1898"
era_id = &"missionary_foundations"
era_display = "Missionary Foundations"
title = "Transition in Parish Administration"
context_label = "DOMINICAN ADMINISTRATION"
change_label = "TRANSITION TOWARD"
result_label = "FILIPINO DIOCESAN CLERGY"
result_connector = "none"
explanation = "Dominican administration came to an end around the close of Spanish rule, and the parish later came under Filipino diocesan clergy."
source_basis = "Epiphany of Our Lord Parish historical account"

[sub_resource type="Resource" id="Cathedral"]
script = ExtResource("2")
milestone_id = &"cathedral_1928"
year_short = "1928"
date_display = "1928"
era_id = &"cathedral_development"
era_display = "Cathedral Development"
title = "Cathedral and Episcopal Seat"
context_label = "PARISH CHURCH"
change_label = "CATHEDRAL"
result_label = "EPISCOPAL SEAT"
result_connector = "plus"
explanation = "On May 19, 1928, the Diocese of Lingayen was established, and Lingayen Church became its cathedral and episcopal seat."
media_mode = &"CONTEXTUAL_PORTRAIT"
media = ExtResource("4")
media_caption = "Bishop César María Guerrero became the first Bishop of Lingayen."
media_credit = "SOURCE: Lingayen: Memories of Times Past (2021), p. 16."
source_basis = "Archdiocese of Lingayen-Dagupan — historical materials and The Archbishops"


[resource]
script = ExtResource("1")
subtitle = "Lingayen Church"
overview_heading = "A Church Across Changing Times"
overview_body = "From its missionary beginnings to its role as a co-cathedral, Lingayen Church passed through major periods of religious, institutional, and wartime change."
overview_media = ExtResource("3")
overview_media_credit = "PHOTO: AKAR Research Team, 2026"
takeaway = "Lingayen Church developed across missionary, cathedral, wartime, and co-cathedral periods while continuing to serve the religious community of Lingayen."
milestones = Array[ExtResource("2")]([SubResource("Early"), SubResource("Transition"), SubResource("Cathedral"), SubResource("Columban"), SubResource("Wartime"), SubResource("CoCathedral"), SubResource("Archdiocese"), SubResource("Leadership")])

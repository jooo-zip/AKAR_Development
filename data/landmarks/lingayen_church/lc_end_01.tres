[sub_resource type="Resource" id="Roots"]
script = ExtResource("2")
theme_id = &"HISTORICAL_ROOTS"
title = "Historical Roots"
short_title = "Historical Roots"
accessible_title = "Historical Roots"
heading = "Centuries of Religious History"
interpretation = "Lingayen Church traces its history to early Catholic missionary activity in the 16th century and was historically known as Los Tres Reyes or the Three Kings Parish."
meaning_statement = "A long religious history connected with the development of Lingayen."
center_context_primary = "EARLY MISSIONARY ROOTS"
center_context_secondary = "LOS TRES REYES"
source_basis = "Archdiocese of Lingayen-Dagupan — historical materials; Epiphany parish history"

[sub_resource type="Resource" id="Cathedral"]
script = ExtResource("2")
theme_id = &"CATHEDRAL_ROLE"
title = "Cathedral & Co-Cathedral"
short_title = "Cathedral Role"
accessible_title = "Cathedral and Co-Cathedral"
heading = "A Changing Institutional Role"
interpretation = "Lingayen Church became the cathedral and episcopal seat of the Diocese of Lingayen in 1928. After the episcopal seat moved to Dagupan in 1954, the church retained its historical role as a co-cathedral."
meaning_statement = "A church whose institutional role changed while its historical significance continued."
center_context_primary = "1928
CATHEDRAL & EPISCOPAL SEAT"
center_context_secondary = "1954
CO-CATHEDRAL"
source_basis = "Archdiocese of Lingayen-Dagupan — historical materials; Epiphany parish history"

[sub_resource type="Resource" id="War"]
script = ExtResource("2")
theme_id = &"WAR_RECOVERY"
title = "War & Recovery"
short_title = "War & Recovery"
accessible_title = "War and Recovery"
heading = "History Marked by Wartime Change"
interpretation = "The church was partially destroyed during the 1945 liberation of Lingayen and was later reconstructed. Surviving historical features continue to connect the present church with its wartime past."
meaning_statement = "A heritage site shaped by destruction, recovery, and historical continuity."
center_context_primary = "1945
WARTIME DAMAGE"
center_context_secondary = "↓
RECONSTRUCTION"
source_basis = "Epiphany parish history; Lingayen: Memories of Times Past (2021), pp. 20, 30"

[sub_resource type="Resource" id="Living"]
script = ExtResource("2")
theme_id = &"LIVING_HERITAGE"
title = "Living Heritage"
short_title = "Living Heritage"
accessible_title = "Living Heritage"
heading = "A Historic Church Still in Use"
interpretation = "Lingayen Church is not only a historical site. It remains an active Roman Catholic parish and co-cathedral serving the religious community of Lingayen."
meaning_statement = "A connection between Lingayen's historical heritage and continuing religious community life."
center_context_primary = "ACTIVE PARISH"
center_context_secondary = "+
CO-CATHEDRAL TODAY"
source_basis = "Archdiocese of Lingayen-Dagupan — Parishes; Epiphany parish history"


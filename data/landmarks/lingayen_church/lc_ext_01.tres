[sub_resource type="Resource" id="About"]
script = ExtResource("2")
section_id = &"ABOUT"
tab_label = "ABOUT THE CHURCH"
takeaway = "Lingayen Church is both a historic landmark and a living religious community."
image = ExtResource("4")
image_caption = "Lingayen Church — present-day view"
source_credit = "Archdiocese of Lingayen-Dagupan — Parishes

Full bibliographic details pending researcher input."
heading = "Epiphany of Our Lord Co-Cathedral Parish"
body = "Commonly known as Lingayen Church, it is an active Roman Catholic parish in Lingayen, Pangasinan. Its history is connected with centuries of Catholic missionary activity and the religious development of the community."

[sub_resource type="Resource" id="HistoricalName"]
script = ExtResource("2")
section_id = &"HISTORICAL_NAME"
tab_label = "HISTORICAL NAME"
takeaway = "The church's historical name reflects its long religious identity in Lingayen."
image_caption = "Lingayen Church — present-day view"
source_credit = "Epiphany of the Lord Parish — historical account

Full bibliographic details pending researcher input."
heading = "Los Tres Reyes — The Three Kings Parish"
body = "The parish was historically known as Los Tres Reyes, or the Three Kings Parish. The name is connected with the biblical Magi associated with the Epiphany of the Lord. Its history reaches back to Catholic missionary activity in Lingayen during the Spanish colonial period."

[sub_resource type="Resource" id="PresentRole"]
script = ExtResource("2")
section_id = &"PRESENT_ROLE"
tab_label = "PRESENT ROLE"
takeaway = "Its historical importance continues alongside its present religious function."
image_caption = "Lingayen Church — present-day view"
source_credit = "Archdiocese of Lingayen-Dagupan — Parishes

Full bibliographic details pending researcher input."
heading = "A Living Religious and Cultural Landmark"
body = "Lingayen Church continues to serve its parish community while retaining its historical role as a co-cathedral. Its continuing religious use connects the church's past with the community that still gathers here today."


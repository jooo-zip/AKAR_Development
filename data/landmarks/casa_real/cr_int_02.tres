[resource]
script = ExtResource("content")
hotspot_id = "CR-INT-02"
visit_modal_title = "ENTER THE FULL EXPERIENCE AT BANÁAN"
visit_modal_body = "You’ve seen a glimpse of this gallery in AKAR.\n\nVisit the Banáan Pangasinan Provincial Museum to experience the complete exhibits, artifacts, and curatorial narratives in person."
reservation_heading = "Online Reservation"
reservation_label = "banaan.seepangasinan.com/online-reservation/"
reservation_url = "https://banaan.seepangasinan.com/online-reservation/"
visitor_info_heading = "Visitor Information"
visitor_info_label = "banaan.seepangasinan.com/visitor-guidelines/"
visitor_info_url = "https://banaan.seepangasinan.com/visitor-guidelines/"
museum_inquiries_heading = "Museum inquiries"
museum_phone = "(075) 511-9821"
museum_email = "banaanppm@gmail.com"
visit_back_label = "BACK"
title = "DISCOVER BANÁAN"
subtitle = "Explore the gallery spaces of the Banáan Pangasinan Provincial Museum"
overview_heading = "EXPLORE BANÁAN MUSEUM"
overview_body = "Banáan Museum presents the environment, history, traditions, people, creativity, and identity of Pangasinan through 11 principal gallery groupings. Select a gallery to preview its identity, then explore the museum at your own pace."
invitation = "Visit Banáan Museum to experience the complete exhibition."
directory_helper = "SWIPE OR TAP A GALLERY TO PREVIEW · DRAG OR USE ← → TO BROWSE"
learning_takeaway = "Banáan Museum brings different aspects of Pangasinan’s environment, history, people, and cultural identity together within the restored Casa Real."
narration_transcript = "The Banáan Pangasinan Provincial Museum presents the many stories that shape Pangasinan’s identity. Explore the gallery spaces at your own pace, then visit Banáan Museum to experience the complete exhibits, artifacts, and curatorial narratives."
source_credit = "GALLERY DIRECTORY\nOfficial Banáan gallery titles supplied and approved by the researcher in the CR-INT-02 Phase 5 specification. 11 principal gallery groupings; 13 selectable entries because Galleries 5 and 6 have A/B subdivisions. A separate directory publication URL was not supplied.\n\nGALLERY PHOTOGRAPHS\nDaily Tribune — Galleries 2, 4, 6A, 7, 10, 11\nCultural encounter, historic gathering: Pangasinan opens its first provincial museum. Daily Tribune, 27 November 2023. Article author: Roel Hoang Manipon.\nDaily Tribune. Article author: Roel Hoang Manipon. Photographer not identified in supplied documentation. Project-use approval confirmed by researcher; license/copyright unspecified.\n\nTikTok — Galleries 5B, 6B, 8\nTikTok — source account: Tom Ora | Akar ng Pangasinense. Photographer not documented. Project-use approval confirmed by researcher; license/copyright unspecified. Exact post URL not recorded in project documentation.\n\nGetaway.PH — Gallery 9\nBANÁAN: Pangasinan’s first-ever provincial museum opens to the public. Getaway.PH, 25 September 2023. Kenneth M. del Rosario.\nGetaway.PH. Author and photographer: Kenneth M. del Rosario. Project-use approval confirmed by researcher; license/copyright unspecified.\n\nAKAR Research Team — Galleries 1, 3, 5A\nAKAR Research Team. Project-use approval: confirmed. License unspecified.\n\nGALLERY GLIMPSE VIDEOS\nAll 13 recordings: AKAR Research Team. Documentary gallery-space recordings. Project-use approval confirmed. Individual videographer and license unspecified. Playback muted; original files preserved.\n\nNARRATION\nAKAR Research Team — approved CR-INT-02 narration. Project-use approval confirmed. Narrator name and license unspecified. No background music added by this component."
narration_stream = ExtResource("audio")
galleries = Array[ExtResource("gallery")]([SubResource("g01"), SubResource("g02"), SubResource("g03"), SubResource("g04"), SubResource("g05a"), SubResource("g05b"), SubResource("g06a"), SubResource("g06b"), SubResource("g07"), SubResource("g08"), SubResource("g09"), SubResource("g10"), SubResource("g11")])

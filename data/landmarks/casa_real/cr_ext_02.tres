heading = "Spanish Colonial Architecture with Georgian Influence"
body = "Casa Real is a two-storey stone-and-brick masonry structure. Among its documented architectural features are its thick masonry walls, wooden balcony, and piedra china staircase."

[resource]
script = ExtResource("1")
overview = SubResource("Overview")
hotspot_id = "CR-EXT-02"
title = "ARCHITECTURE OF THE ROYAL HOUSE"
prompt = "Spanish Colonial Architecture with Georgian Influence"
illustration = ExtResource("facade")
illustration_alt_text = "Casa Real — Full Façade"
narration_stream = ExtResource("audio")
narration_transcript = "Casa Real combines Spanish colonial architecture with Georgian influence. Its architectural character includes thick masonry walls designed for durability, a prominent wooden balcony, and a piedra china staircase made of granite. These features are important details to observe when examining the historic structure."
learning_takeaway = "Casa Real's architecture combines durable masonry construction with distinctive features such as its wooden balcony and piedra china staircase."
source_credit = "Architectural interpretation

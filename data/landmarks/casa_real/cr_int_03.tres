[resource]
script = ExtResource("content")
hotspot_id = "CR-INT-03"
title = "PEOPLE BEHIND CASA REAL"
prompt = "MEET THE PEOPLE CONNECTED WITH CASA REAL"
narration_stream = ExtResource("audio")
narration_transcript = "Casa Real's history was shaped by personalities connected with civil government, restoration, and museum development. Their contributions reflect the building's transformation from a colonial government center into a preserved cultural institution."
people = Array[ExtResource("person")]([SubResource("P0"), SubResource("P1"), SubResource("P2"), SubResource("P3"), SubResource("P4")])
period_ids = Array[StringName]([&"PERIOD_CIVIL_GOVERNMENT", &"PERIOD_RESTORATION", &"PERIOD_BANAAN"])
period_labels = PackedStringArray("CIVIL GOVERNMENT", "RESTORATION & PRESERVATION", "BANÁAN MUSEUM")
compact_period_labels = PackedStringArray("1901", "RESTORATION", "2023")
overview_heading = "WHO HELPED SHAPE CASA REAL'S PUBLIC STORY?"
overview_body = "Meet the people connected with Casa Real\nacross different periods of its history."
overview_helper = "TAP A PERIOD OR PORTRAIT TO EXPLORE"
period_helper = "SELECT A PERSON FROM THIS PERIOD"
anchor_title = "CASA REAL"
anchor_location = "LINGAYEN, PANGASINAN"
source_credit = "HISTORICAL CONTENT\nAKAR Research Team — researcher-approved Casa Real connections.\n\nNARRATION\nAKAR Research Team — project-owned narration."

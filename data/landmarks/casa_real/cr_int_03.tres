overview_heading = "WHO HELPED SHAPE CASA REAL'S PUBLIC STORY?"
overview_body = "Meet the people connected with Casa Real
across different periods of its history."
overview_helper = "TAP A PERIOD OR PORTRAIT TO EXPLORE"
period_helper = "SELECT A PERSON FROM THIS PERIOD"
anchor_title = "CASA REAL"
anchor_location = "LINGAYEN, PANGASINAN"
hotspot_id = "CR-INT-03"
title = "PEOPLE BEHIND CASA REAL"
prompt = "MEET THE PEOPLE CONNECTED WITH CASA REAL"
narration_stream = ExtResource("audio")
narration_transcript = "Casa Real's history was shaped by personalities connected with civil government, restoration, and museum development. Their contributions reflect the building's transformation from a colonial government center into a preserved cultural institution."
source_credit = "HISTORICAL CONTENT
AKAR Research Team — researcher-approved Casa Real connections.

NARRATION
AKAR Research Team — project-owned narration."

period_id = "PERIOD_CIVIL_GOVERNMENT"
period_label = "CIVIL GOVERNMENT"
date_label = "1901"
compact_date = "1901"
contribution = "Led the Second Philippine Commission and visited Casa Real during the establishment of civil government in Pangasinan in 1901."

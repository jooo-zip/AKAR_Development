[sub_resource type="Resource" id="Capitol"]
script = ExtResource("2")
view_id = &"capitol"
selector_label = "THE CAPITOL"
context_label = "SEAT OF PROVINCIAL GOVERNMENT"
heading = "The Pangasinan Provincial Capitol"
body = "The Pangasinan Provincial Capitol is the seat of the Provincial Government of Pangasinan. Located in Lingayen, it continues to serve as an active center of provincial governance."
takeaway = "A historic landmark that remains a working government center."
focus_region = Rect2(0.08, 0.07, 0.84, 0.88)
image = ExtResource("3")
caption = "Present-day view of the Pangasinan Provincial Capitol, Lingayen."
media_credit = "Photographer/creator: AKAR Team
Source: AKAR Research Team"
permission_status = "Research-team-produced documentary photograph."

[sub_resource type="Resource" id="CivicSetting"]
script = ExtResource("2")
view_id = &"civic_setting"
selector_label = "CIVIC SETTING"
context_label = "WITHIN THE GOVERNMENT COMPLEX"
heading = "A Landmark Framed by Its Setting"
body = "The Capitol stands within a spacious government complex near Lingayen Gulf. Formal gardens, lawns, paved approaches, and tree-lined avenues frame the building."
takeaway = "Its setting strengthens its role as a civic landmark."
observation_labels = PackedStringArray("CAPITOL", "FORMAL APPROACH", "LANDSCAPED GROUNDS")
image = ExtResource("4")
caption = "The Capitol within its formal government-complex setting in Lingayen."
media_credit = "Source: Official Province of Pangasinan website
Page/context: The Province → History"
permission_status = "Not separately confirmed / pending documentation."

[sub_resource type="Resource" id="GovernmentToday"]
script = ExtResource("2")
view_id = &"government_today"
selector_label = "GOVERNMENT TODAY"
context_label = "CONTINUING CIVIC ROLE"
heading = "A Working Seat of Provincial Government"
body = "The Capitol continues to serve the Provincial Government of Pangasinan while preserving its historical character. It remains both a heritage landmark and an active government building."
takeaway = "Its history and government function continue today."
observation_labels = PackedStringArray("ACTIVE GOVERNMENT CENTER")
image = ExtResource("5")
caption = "The Pangasinan Provincial Capitol remains an active provincial government center."
media_credit = "Photographer/creator: AKAR Team
Source: AKAR Research Team"
permission_status = "Research-team-produced documentary photograph."

[resource]
script = ExtResource("1")
hotspot_id = "ppc_ext_01"
title = "MEET THE PANGASINAN
PROVINCIAL CAPITOL"
prompt = "LINGAYEN, PANGASINAN"
illustration = ExtResource("3")
illustration_alt_text = "Present-day view of the Pangasinan Provincial Capitol, Lingayen."
narration_stream = ExtResource("6")
narration_transcript = "Welcome to the Pangasinan Provincial Capitol in Lingayen. The Capitol is the building where the executive and legislative functions of the Provincial Government of Pangasinan are carried out. It stands within a spacious government complex near Lingayen Gulf, framed by formal gardens, open lawns, paved approaches, and tree-lined avenues. More than a historic landmark, the Capitol continues to serve as a center of provincial governance today. Explore the views to learn about the building, its civic setting, and its continuing role."
source_credit = "HISTORICAL REFERENCES

1. AKAR Historical Information Validation Sheet — Pangasinan Provincial Capitol
Relevant support: Capitol is the building where executive and legislative functions of the Provincial Government of Pangasinan are carried out.

2. Historical Profile of Pangasinan Provincial Capitol
Relevant support: landmark identity, Lingayen location, continuing government role, government-complex setting, formal gardens, lawns, approaches, tree-lined avenues."
concepts = [SubResource("Capitol"), SubResource("CivicSetting"), SubResource("GovernmentToday")]
metadata/audio_credit = "AUDIO
ppc_ext_01_narration
Narration production: AKAR Team"
